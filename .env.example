# Point your domain's DNS A record at the public IP of your server.
DOMAIN=voice.example.com

# Use Gemini for the hosted AI provider. On a 429 quota response, the next key is tried.
# Use keys with independent available quotas; keys in one project can share the same limits.
# Restart the app after changing these values.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEYS=replace-with-first-key,replace-with-second-key
# Existing single-key setup still works with GEMINI_API_KEY.
# Separate entries GEMINI_API_KEY and GEMINI_API_KEY2 are also supported.

# Manual TaskFlow workspace invitations. Configure an HTTPS invite/signup URL and SMTP.
TASKFLOW_WORKSPACE_URL=https://your-taskflow-domain.example/invite
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=invites@example.com

# Login protection for the shared demo site.
SITE_USER=taskflow
SITE_PASSWORD_HASH=replace-with-caddy-password-hash
